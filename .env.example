# Modo demonstração (/demonstracao) — variáveis do SERVIDOR (nunca NEXT_PUBLIC_).
# Copiar para .env.local (local) ou definir no painel Node.js do cPanel.
# NÃO colocar valores reais neste ficheiro nem no repositório.

# Utilizador de acesso à demonstração
DEMO_USER=

# Hash scrypt da palavra-passe (recomendado). Gerar com:
#   node scripts/demo-password-hash.mjs
# Formato: scrypt:<sal>:<hash>
DEMO_PASSWORD_HASH=

# Alternativa SÓ para testes locais (texto simples). Ignorada se houver hash.
# DEMO_PASSWORD=

# Segredo para assinar o cookie de sessão (HMAC-SHA256), mínimo 32 caracteres.
# Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
DEMO_SESSION_SECRET=
